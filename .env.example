# ---------------------------------------------------------------------------
# HUMAN
#
# Everything here is optional. With an empty .env the app runs on a local
# file-backed store with no external services, which is what `npm run dev`
# does on a clean checkout. Add these as you connect real infrastructure.
# ---------------------------------------------------------------------------

# Public origin. Used for share links, challenge links and OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets (server-only, required in production) --------------------------
# Signs run tokens and guest identity cookies. Rotating it logs every guest
# out and invalidates in-flight runs, so rotate between days, not mid-day.
HUMAN_RUN_SECRET=

# Seeds the daily manifests. THIS IS THE ONE THAT MATTERS: the same secret
# plus the same date always regenerates the same five events, so a lost
# database can be rebuilt. Changing it changes every future day. Never commit
# the production value.
HUMAN_MANIFEST_SECRET=

# --- Supabase (Postgres + Auth) ---------------------------------------------
# With these set the app uses Postgres and real sign-in. Without them it uses
# the file-backed development store and the documented dev-mode link path.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (optional) -----------------------------------------------
# Rate limiting falls back to a per-process map when these are absent, which
# is fine locally and not fine across more than one instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics and error reporting (optional) -------------------------------
# Both are no-ops when unset; no events are sent and nothing is logged
# externally.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# --- Admin ------------------------------------------------------------------
# Comma-separated. A player matching either list gets the /admin console.
# In development with both empty, the local guest is an admin.
HUMAN_ADMIN_USERNAMES=
HUMAN_ADMIN_EMAILS=

# --- Local development store ------------------------------------------------
# Where the file-backed store writes. Ignored when Supabase is configured.
HUMAN_DEV_DB=.data/human-dev.json
