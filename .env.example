# ---------------------------------------------------------------------------
# HUMAN
#
# Local development: everything here is optional. With an empty .env the app
# runs on a local file-backed store and in-repo development secrets, which is
# what `npm run dev` does on a clean checkout.
#
# Production: the process refuses to start unless the secrets, Supabase, and
# an admin allowlist are set to real values. See docs/deployment.md.
# ---------------------------------------------------------------------------

# Public origin. Used for share links, challenge links and OG image URLs.
# Required in production so share cards do not point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets (server-only, required in production) --------------------------
# Signs run tokens and guest identity cookies. Rotating it logs every guest
# out and invalidates in-flight runs, so rotate between days, not mid-day.
# Must not be the in-repo development default in production.
HUMAN_RUN_SECRET=

# Seeds the daily manifests. THIS IS THE ONE THAT MATTERS: the same secret
# plus the same date always regenerates the same five events, so a lost
# database can be rebuilt. Changing it changes every future day. Never commit
# the production value.
HUMAN_MANIFEST_SECRET=

# --- Supabase (Postgres + Auth) — required in production --------------------
# With these set the app uses Postgres and real sign-in. Without them it uses
# the file-backed development store and the documented dev-mode link path.
# Production throws if these are missing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (recommended in production, required if multi-instance) --
# Rate limiting falls back to a per-process map when these are absent, which
# is fine locally and not fine across more than one instance. Production
# warns but does not refuse to start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics and error reporting (optional) -------------------------------
# Both are no-ops when unset; no events are sent and nothing is logged
# externally. Set these before a public launch.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# --- Admin (required in production) -----------------------------------------
# Comma-separated. A player matching either list gets the /admin console.
# In development with both empty, the local guest is an admin. Production
# refuses to start if both are empty.
HUMAN_ADMIN_USERNAMES=
HUMAN_ADMIN_EMAILS=

# --- Local development store ------------------------------------------------
# Where the file-backed store writes. Ignored when Supabase is configured.
# Setting this also exempts `next start` from the production env guard so
# Playwright can boot a production build against the file store.
HUMAN_DEV_DB=.data/human-dev.json

# Force the production env guard on (1) or off (0). Unset = infer from
# NODE_ENV and HUMAN_DEV_DB.
# HUMAN_ENFORCE_PROD=

# Vercel Cron secret. Required for /api/cron/daily on a real host.
# CRON_SECRET=

# Optional transactional email (Resend). Daily reminders no-op without it.
# RESEND_API_KEY=
# EMAIL_FROM=HUMAN <hello@example.com>
